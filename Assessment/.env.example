# Copy to .env (docker compose reads .env automatically). Defaults work out of the box.

# --- Postgres ---
POSTGRES_USER=donkey
POSTGRES_PASSWORD=donkey
POSTGRES_DB=donkey
# Used by the API (Prisma). Host = postgres service name on the compose network.
DATABASE_URL=postgresql://donkey:donkey@postgres:5432/donkey?schema=public

# --- API ---
API_PORT=4000

# --- BetterAuth (runs inside the API) ---
# Min 32 chars. Change for anything real.
BETTER_AUTH_SECRET=dev-secret-change-me-please-32-chars-minimum
# Public origin of the web app; BetterAuth builds callback URLs from this.
BETTER_AUTH_URL=http://localhost:3000

# --- Keycloak admin bootstrap (Keycloak 26+) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Keycloak OIDC client used by genericOAuth ---
KEYCLOAK_CLIENT_ID=donkey-web
KEYCLOAK_CLIENT_SECRET=donkey-web-secret
# Browser-facing realm URL (used for the authorization redirect).
KEYCLOAK_PUBLIC_URL=http://localhost:8080/realms/donkey
# Internal (compose network) realm URL (used for back-channel token/userinfo calls).
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/donkey

# --- Web ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Internal URL the Next server uses to reach the API (rewrites + server fetch).
API_INTERNAL_URL=http://api:4000
