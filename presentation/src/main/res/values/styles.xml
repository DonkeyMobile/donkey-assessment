<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>


    <style name="SplashFragmentTitle">
        <item name="android:textColor">@color/splashTitle</item>
        <item name="android:textSize">@dimen/title</item>
    </style>

    <style name="SplashFragmentSubTitle">
        <item name="android:textColor">@color/splashSubTitle</item>
        <item name="android:textSize">@dimen/subtitle</item>
    </style>

    <style name="PostTitle">
        <item name="fontFamily">@font/alef_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/title</item>
    </style>

    <style name="UserAvatar">
        <item name="fontFamily">@font/alef_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/normal</item>
    </style>

    <style name="UserName">
        <item name="fontFamily">@font/alef_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/large</item>
    </style>

    <style name="Bio">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/normal</item>
    </style>

    <style name="PostMessage">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/normal</item>
    </style>

    <style name="PostTimeStamp">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/metaText</item>
        <item name="android:textSize">@dimen/small</item>
    </style>

    <style name="TopBarTitle">
        <item name="fontFamily">@font/alef_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/subtitle</item>
    </style>

    <style name="Button">
        <item name="fontFamily">@font/alef_regular</item>
        <item name="android:textColor">@color/textColor</item>
        <item name="android:textSize">@dimen/large</item>
    </style>

    <style name="ErrorMessage">
        <item name="fontFamily">@font/lato_regular</item>
        <item name="android:textColor">@color/metaText</item>
        <item name="android:textSize">@dimen/small</item>
    </style>
</resources>